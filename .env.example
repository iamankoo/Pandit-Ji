# Development environment template for `infrastructure/docker-compose.yml`.
#
# Copy to `.env` at the repository root and adjust if needed:
#   cp .env.example .env
#
# These are safe local-development placeholders, not production secrets.
# Never commit the real `.env` file (already covered by .gitignore).

APP_ENV=development
LOG_LEVEL=INFO
API_VERSION=v1

# --- PostgreSQL (used directly by the postgres Compose service) ---
POSTGRES_USER=pandit
POSTGRES_PASSWORD=pandit
POSTGRES_DB=pandit

# --- Database / cache URLs consumed by server/ ---
# Overridden to point at the Compose service names (postgres, valkey) by
# infrastructure/docker-compose.yml's `server.environment` block; set here
# too for running server/ directly on the host against the Compose infra.
DATABASE_URL=postgresql+psycopg://pandit:pandit@localhost:5432/pandit
VALKEY_URL=redis://localhost:6379/0

# --- Auth (Keycloak / OIDC) ---
AUTH_ISSUER_URL=http://localhost:8081/realms/pandit-ji
AUTH_CLIENT_ID=pandit-server
AUTH_CLIENT_SECRET=dev-only-placeholder
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-placeholder

# --- Object storage (MinIO) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=pandit-dev
OBJECT_STORAGE_ACCESS_KEY=dev-only-placeholder
OBJECT_STORAGE_SECRET_KEY=dev-only-placeholder

# --- AI / LLM inference (LLMProvider target -- see ADR-002) ---
# Default points at a locally-run Ollama; not started by docker-compose.yml.
AI_INFERENCE_BASE_URL=http://localhost:11434
