# Staging environment template. Copy outside version control and fill in
# real values -- never commit real secrets (see infrastructure/ENVIRONMENTS.md).

APP_ENV=staging
LOG_LEVEL=INFO
API_VERSION=v1

DATABASE_URL=postgresql+psycopg://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/pandit_staging
VALKEY_URL=redis://REPLACE_ME:6379/0

AUTH_ISSUER_URL=https://REPLACE_ME/realms/pandit-ji-staging
AUTH_CLIENT_ID=pandit-server
AUTH_CLIENT_SECRET=REPLACE_ME

OBJECT_STORAGE_ENDPOINT=https://REPLACE_ME
OBJECT_STORAGE_BUCKET=pandit-staging
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
OBJECT_STORAGE_SECRET_KEY=REPLACE_ME

AI_INFERENCE_BASE_URL=https://REPLACE_ME
