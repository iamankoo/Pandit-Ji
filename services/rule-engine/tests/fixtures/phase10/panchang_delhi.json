 "profile_id": "PANCHANG_DRIK_CRC_1955_V1",
 "provenance": [
  {
   "entry_id": "prov.day",
   "evidence_label": "source_supported",
   "item": "Civil day and Vara",
   "references": [
    {
     "locator": "Art. 5 (p. 2), Art. 31-32 (pp. 19-20)",
     "note": "",
     "source_id": "SRC-SEWELL-DIKSHIT-INDIAN-CALENDAR-1896",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    },
    {
     "locator": "Recommendation (8), p. 7",
     "note": "",
     "source_id": "SRC-CALENDAR-REFORM-COMMITTEE-1955",
     "verification_level": "IMAGE-ORIGINAL-ENGLISH"
    },
    {
     "locator": "Part B, Calendar for five years, explanation (6)",
     "note": "",
     "source_id": "SRC-CALENDAR-REFORM-COMMITTEE-1955",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "The day and the weekday run from sunrise to sunrise; a day bears the tithi (and other elements) current at its sunrise."
  },
  {
   "entry_id": "prov.sunrise",
   "evidence_label": "source_supported",
   "item": "Sunrise and sunset",
   "references": [
    {
     "locator": "Part B, Calendar for five years, explanation (5); minutes, item (8)",
     "note": "reproduced to the minute on the printed calendar for Saka 1876 (pp. 41-42, page images)",
     "source_id": "SRC-CALENDAR-REFORM-COMMITTEE-1955",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "Sunrise and sunset are the moments the centre of the Sun is on the horizon as affected by refraction, taken as 30 minutes of arc (default); the upper-limb convention of Phase 4 is an explicit alternative."
  },
  {
   "entry_id": "prov.elements",
   "evidence_label": "source_supported",
   "item": "Tithi, Nakshatra, Yoga, Karana",
   "references": [
    {
     "locator": "Art. 7-10 (pp. 3-4)",
     "note": "",
     "source_id": "SRC-SEWELL-DIKSHIT-INDIAN-CALENDAR-1896",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    },
    {
     "locator": "Recommendations (7) and (9), p. 7",
     "note": "",
     "source_id": "SRC-CALENDAR-REFORM-COMMITTEE-1955",
     "verification_level": "IMAGE-ORIGINAL-ENGLISH"
    },
    {
     "locator": "pp. 12-14 (yoga and karana lists)",
     "note": "",
     "source_id": "SRC-RAMAN-MUHURTHA-1948",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    },
    {
     "locator": "p. 99 footnote (fixed karanas)",
     "note": "",
     "source_id": "SRC-KALAPRAKASIKA-IYER-1917",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "Tithi: the Moon gains 12 degrees on the Sun; Karana: half a tithi (6 degrees), Kimstughna, seven movable karanas eight times, Shakuni, Chatushpada, Naga; Yoga: the sum of the sidereal longitudes in 13 deg 20 min parts; Nakshatra: 13 deg 20 min of the sidereal zodiac from Ashwini; true (apparent) longitudes; nakshatras with the variable ayanamsa (Lahiri)."
  },
  {
   "entry_id": "prov.month",
   "evidence_label": "source_supported",
   "item": "Lunar month, adhika and kshaya",
   "references": [
    {
     "locator": "Recommendation (6), p. 7",
     "note": "",
     "source_id": "SRC-CALENDAR-REFORM-COMMITTEE-1955",
     "verification_level": "IMAGE-ORIGINAL-ENGLISH"
    },
    {
     "locator": "Art. 13-14, 48, 51 (pp. 4-5, 29-31)",
     "note": "",
     "source_id": "SRC-SEWELL-DIKSHIT-INDIAN-CALENDAR-1896",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "Amanta months run from new moon to new moon and are named after the saura month in which the new moon falls; two new moons in one saura month make the first month adhika; a saura month without a new moon gives a suppressed (kshaya) name. Purnimanta: the dark fortnight takes the name of the following month."
  },
  {
   "entry_id": "prov.saura_frames",
   "evidence_label": "unresolved_conflict",
   "item": "Saura month frames",
   "references": [
    {
     "locator": "Recommendations (5) and (7), p. 7",
     "note": "",
     "source_id": "SRC-CALENDAR-REFORM-COMMITTEE-1955",
     "verification_level": "IMAGE-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "The Committee fixed the saura months 23 deg 15 min ahead of the vernal equinox; nakshatras use the variable (Lahiri) ayanamsa. Almanacs that measure sankrantis with the variable ayanamsa are not verified in a primary source read, so both frames are computed and reported; they differ by the growth of the ayanamsa since 1956."
  },
  {
   "entry_id": "prov.day_parts",
   "evidence_label": "source_supported",
   "item": "Eighth parts of the day",
   "references": [
    {
     "locator": "Ch. XXXIII p. 175 (text)",
     "note": "",
     "source_id": "SRC-KALAPRAKASIKA-IYER-1917",
     "verification_level": "IMAGE-TRANSLATION"
    },
    {
     "locator": "p. 176 tables",
     "note": "the tables use a 12-hour day from 6 o'clock; dividing the actual sunrise-to-sunset span into eight is PC-19's inference",
     "source_id": "SRC-KALAPRAKASIKA-IYER-1917",
     "verification_level": "IMAGE-TRANSLATION"
    }
   ],
   "statement": "The day is divided into eight parts; the lord of the day governs the first and the last, the other lords follow in weekday order; Saturn's part is Gulika. Yamaganda: 5th, 4th, 3rd, 2nd, 1st, 7th, 6th part Sunday to Saturday."
  },
  {
   "entry_id": "prov.rahu_kalam",
   "evidence_label": "translator_note",
   "item": "Rahu Kalam",
   "references": [
    {
     "locator": "p. 176 footnote",
     "note": "the translator's, not the text's",
     "source_id": "SRC-KALAPRAKASIKA-IYER-1917",
     "verification_level": "IMAGE-TRANSLATION"
    }
   ],
   "statement": "Daytime only: Sunday 8th part, Monday 2nd, Tuesday 7th, Wednesday 5th, Thursday 6th, Friday 4th, Saturday 3rd (clock times for a 6-to-6 day)."
  },
  {
   "entry_id": "prov.hora",
   "evidence_label": "source_supported",
   "item": "Hora",
   "references": [
    {
     "locator": "p. 176 (text) and p. 177 table (hours from 6 o'clock)",
     "note": "",
     "source_id": "SRC-KALAPRAKASIKA-IYER-1917",
     "verification_level": "IMAGE-TRANSLATION"
    },
    {
     "locator": "Art. 68-70",
     "note": "equal hours from sunrise",
     "source_id": "SRC-RAMAN-GRAHA-BHAVA-BALAS",
     "verification_level": "IMAGE-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "Horas of one hour from sunrise; the first is the weekday lord, each next lord the sixth in weekday order from the previous one."
  },
  {
   "entry_id": "prov.panchaka",
   "evidence_label": "modern_tradition",
   "item": "Panchaka",
   "references": [
    {
     "locator": "pp. 19-22 (remainder), p. 26 (nakshatra panchaka)",
     "note": "",
     "source_id": "SRC-RAMAN-MUHURTHA-1948",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    },
    {
     "locator": "Ch. XXIX pp. 161-162",
     "note": "",
     "source_id": "SRC-KALAPRAKASIKA-IYER-1917",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "Two different things share the name. Nakshatra Panchaka: the Moon from the third quarter of Dhanishta to the end of Revati (Raman). Remainder Panchaka: tithi (1-30) + weekday (Sunday 1) + nakshatra (Ashwini 1) + lagna (Aries 1), divided by 9; remainders 1, 2, 4, 6, 8 are Mrityu, Agni, Raja, Chora, Roga (Raman; the same test as Kalaprakasika's 'add 15, 12, 10, 8, 4 and look for remainder 5')."
  },
  {
   "entry_id": "prov.bhadra",
   "evidence_label": "modern_tradition",
   "item": "Bhadra",
   "references": [
    {
     "locator": "pp. 13-14, 29",
     "note": "",
     "source_id": "SRC-RAMAN-MUHURTHA-1948",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "Bhadra is the Vishti karana (Raman lists Visti among the karanas and calls Bhadra unfit for good work). Bhadra's residence (loka) rules are not implemented."
  },
  {
   "entry_id": "prov.tara_chandra",
   "evidence_label": "source_supported",
   "item": "Tara Bala and Chandra Bala",
   "references": [
    {
     "locator": "Ch. XXXIII pp. 166-167",
     "note": "",
     "source_id": "SRC-KALAPRAKASIKA-IYER-1917",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    },
    {
     "locator": "pp. 17-18",
     "note": "",
     "source_id": "SRC-RAMAN-MUHURTHA-1948",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "Tara: count from the birth nakshatra to the day's, divide by 9; 1 Janma, 2 Sampat, 3 Vipat, 4 Kshema, 5 Pratyak, 6 Sadhana, 7 Naidhana, 8 Mitra, 9 Parama Mitra. Chandra Bala: Kalaprakasika avoids only the 8th from the birth Moon sign (Chandrashtama); Raman avoids the 6th, 8th and 12th."
  },
  {
