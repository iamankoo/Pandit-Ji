 "provenance": [
  {
   "entry_id": "prov.ayanamsa",
   "evidence_label": "source_supported",
   "item": "Ayanamsa: KP_AYANAMSA_KRISHNAMURTI_SWISSEPH",
   "references": [
    {
     "locator": "'Ayanamsa' section and the yearly Ayanamsa table (printed pp. 56-59)",
     "note": "Krishnamurti places the coincidence of the zodiacs in 291 CE and follows Newcomb's precession of 50.2388475 arcseconds a year; the printed table gives the value per year to the arcminute.",
     "source_id": "SRC-KP-READER-I-KRISHNAMURTI",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    },
    {
     "locator": "Yearly Ayanamsa table, 1880-2001, compared on 1 January and 1 July",
     "note": "Swiss Ephemeris agrees with the printed table within 0.9 arcminutes over 1880-2001 (the table is rounded to whole arcminutes); the default was chosen because it agrees more closely than the VP291 variant (up to 2.1 arcminutes).",
     "source_id": "SRC-KP-READER-I-KRISHNAMURTI",
     "verification_level": "ENGINEERING-EVIDENCE"
    },
    {
     "locator": "Section 2.8.6 'Krishnamurti ayanamshas', mode 5",
     "note": "Mode 5 was fitted to Krishnamurti's yearly table (t0 1 January 1900, 22.363889 degrees); the documentation notes that the table repeats values in 1918-1921, which no steady precession can produce.",
     "source_id": "SRC-SWISSEPH-DOC",
     "verification_level": "DOCUMENTATION-DIRECT"
    }
   ],
   "statement": "Krishnamurti ayanamsa as implemented by Swiss Ephemeris (SE_SIDM_KRISHNAMURTI); the default KP ayanamsa"
  },
  {
   "entry_id": "prov.houses",
   "evidence_label": "inference",
   "item": "Houses: KP_HOUSES_PLACIDUS_SIDEREAL_SWISSEPH",
   "references": [
    {
     "locator": "Methods of house division and 'Table of Houses'",
     "note": "The Reader names Placidus's semi-arc system as the method in common use and tells the student to use Raphael's Tables of Houses. That Raphael's tables are Placidian is outside knowledge, not stated in the Reader, hence 'inference'.",
     "source_id": "SRC-KP-READER-I-KRISHNAMURTI",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    },
    {
     "locator": "Worked chart: 'A house commences from the cusp of a house and ends with the succeeding cusp'",
     "note": "House extent and cusp-sign lordship are stated directly.",
     "source_id": "SRC-KP-READER-III-KRISHNAMURTI",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    }
   ],
   "statement": "Placidus cusps computed tropically and reduced by the KP ayanamsa; a house runs from its cusp to the next cusp and is ruled by the lord of the cusp's sign"
  },
  {
   "entry_id": "prov.subdivision",
   "evidence_label": "source_supported",
   "item": "Star/sub division: KP_SUBLORD_VIMSHOTTARI_PROPORTIONAL",
   "references": [
    {
     "locator": "Chapter on the sub (printed pp. 10-13)",
     "note": "Sub spans in proportion to the Vimshottari years; order as in the bhuktis; 249 rather than 243 because some subs fall in two signs. Further subdivision is mentioned only 'for research students'.",
     "source_id": "SRC-KP-READER-III-KRISHNAMURTI",
     "verification_level": "OCR-ORIGINAL-ENGLISH"
    },
    {
     "locator": "Numbered list of the 249 sign-star-sub divisions",
     "note": "202 legible OCR rows agree exactly with the derived table (fixture kp_reader3_sub_table.json).",
